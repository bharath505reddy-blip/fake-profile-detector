[Unit]
Description=Fake Profile Detector Flask App
After=network.target

[Service]
User=flaskapp
Group=www-data
WorkingDirectory=/home/flaskapp/fake-profile-detector
Environment="SECRET_KEY=36b342ae13ab073d14928374ce33e908421ba0b3bfed7bc1d2f9affeb0ca097a"
Environment="REQUIRE_AUTH=true"
Environment="FLASK_ENV=production"
ExecStart=/home/flaskapp/fake-profile-detector/venv/bin/gunicorn \
    app:app \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /home/flaskapp/fake-profile-detector/logs/access.log \
    --error-logfile /home/flaskapp/fake-profile-detector/logs/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target